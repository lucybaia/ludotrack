# --- Discord (obrigatório) ---
# Token do bot: Developer Portal > sua aplicação > Bot > Reset Token
DISCORD_BOT_TOKEN=seu_token_do_bot_discord
# ID do servidor onde o bot e você estão juntos (botão direito no servidor > Copiar ID do servidor)
DISCORD_GUILD_ID=123456789012345678
# SEU ID de usuário (botão direito no seu nome > Copiar ID do usuário)
DISCORD_USER_ID=123456789012345678

# --- Telegram (obrigatório para main.py) ---
# Token do @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyZ
# Chat que recebe as mensagens (seu ID numérico, ID de grupo negativo ou @canal)
TELEGRAM_CHAT_ID=123456789

# --- IGDB via Twitch (opcional: sem isso as mensagens saem sem capa/gênero/ano) ---
IGDB_CLIENT_ID=seu_client_id_twitch
IGDB_CLIENT_SECRET=seu_client_secret_twitch

# --- Supabase (opcional: sem isso as sessões ficam só no SQLite local) ---
# Project Settings > API: "Project URL" e a chave secreta (sb_secret_... ou a legada service_role).
# NUNCA use a chave publishable/anon aqui, e nunca exponha a chave secreta em front-end.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SUPABASE_TABLE=game_sessions
# Intervalo (s) entre sincronizações periódicas; início/fim de sessão sincronizam na hora
# SUPABASE_SYNC_INTERVAL=30

# --- Opcionais ---
# Caminho do banco SQLite (padrão: games.db na pasta do projeto)
# DATABASE_PATH=games.db
# Segundos que uma mudança de jogo precisa durar para ser considerada real
# DEBOUNCE_SECONDS=15
# Activities "playing" a ignorar, separadas por vírgula (ex: extensões de IDE com Rich Presence)
# IGNORED_ACTIVITIES=Visual Studio Code,Spotify
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
